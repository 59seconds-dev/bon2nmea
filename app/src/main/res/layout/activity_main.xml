<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="BON → RaceChrono"
            android:textStyle="bold" android:textSize="26sp"
            android:paddingBottom="8dp" />
        <TextView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="BON1 / BON4 から VBO を生成"
            android:textSize="14sp" android:paddingBottom="24dp" />
        <Button android:id="@+id/buttonOpen"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:text="インポートデータを選択" android:textSize="18sp" />
        <TextView android:id="@+id/textView"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="18dp" android:paddingBottom="18dp"
            android:textSize="15sp" android:text="BONファイルを選択してください" />
        <ProgressBar android:id="@+id/progressBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:indeterminate="true"
            style="?android:attr/progressBarStyleHorizontal" />
        <TextView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="フォルダ"
            android:textStyle="bold" android:textSize="17sp"
            android:layout_marginTop="28dp" />
        <TextView android:id="@+id/folderStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:textSize="14sp" />
        <Button android:id="@+id/buttonSourceFolder"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="入力フォルダを変更" />
        <Button android:id="@+id/buttonOutputFolder"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="出力フォルダを変更" />
    </LinearLayout>
</ScrollView>