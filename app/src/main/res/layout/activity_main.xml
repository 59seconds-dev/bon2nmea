<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BON Converter"
            android:textStyle="bold"
            android:textSize="28sp"
            android:paddingBottom="6dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BON1 / BON4 → RaceChrono"
            android:textSize="15sp"
            android:paddingBottom="22dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1  ファイルを選ぶ"
            android:textStyle="bold"
            android:textSize="18sp" />
        <Button
            android:id="@+id/buttonOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="入力フォルダのBON一覧" />
        <Button
            android:id="@+id/buttonSingleFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BONファイルを直接選択" />
        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textSize="15sp"
            android:text="BONファイルを選択してください" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2  出力形式"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="16dp" />
        <RadioGroup
            android:id="@+id/formatGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/formatVbo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="VBO (RaceChrono)"
                android:layout_marginEnd="18dp" />
            <RadioButton
                android:id="@+id/formatNmea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NMEA" />
        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3  変換して保存"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="16dp" />
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="変換・保存"
            android:enabled="false" />
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            style="?android:attr/progressBarStyleHorizontal"
            android:indeterminate="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="フォルダ設定"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="28dp" />
        <TextView
            android:id="@+id/folderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp" />
        <Button
            android:id="@+id/buttonSourceFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="入力フォルダを変更" />
        <Button
            android:id="@+id/buttonOutputFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存先フォルダを変更" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存先の中に BON4_Converted フォルダを自動作成します"
            android:textSize="12sp"
            android:paddingTop="8dp" />
    </LinearLayout>
</ScrollView>